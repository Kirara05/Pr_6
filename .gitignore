# 1. Виртуальное окружение (огромная папка с библиотеками, её никогда не пушат)
venv/
env/
.venv/

# 2. Служебный кэш Python (создается сам при запуске кода)
__pycache__/
*.py[cod]

# 3. Секреты и настройки (ссылки на БД, пароли, токены)
.env

# 4. Локальные базы данных (чтобы не выкладывать тестовые данные в сеть)
*.db
*.sqlite
*.sqlite3
store/

# 5. Настройки редакторов кода (VS Code, PyCharm)
.vscode/
.idea/

# 6. Системный мусор Windows / Mac
Thumbs.db
.DS_Store